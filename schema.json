{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Chilean Local Artisans Dataset",
  "description": "Schema for local artisan profiles including location, craft type, materials, and cultural background",
  "type": "object",
  "properties": {
    "artisans": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artisan_id", "name", "region", "city", "craft_type", "materials_used", "cultural_background"],
        "properties": {
          "artisan_id": {
            "type": "integer",
            "description": "Unique identifier for the artisan",
            "minimum": 1
          },
          "name": {
            "type": "string",
            "description": "Full name of the artisan",
            "minLength": 1
          },
          "region": {
            "type": "string",
            "description": "Administrative region of Chile",
            "enum": [
              "Región de Arica y Parinacota",
              "Región de Tarapacá",
              "Región de Antofagasta",
              "Región de Atacama",
              "Región de Coquimbo",
              "Región de Valparaíso",
              "Región Metropolitana",
              "Región de O'Higgins",
              "Región del Maule",
              "Región de Ñuble",
              "Región del Biobío",
              "Región de La Araucanía",
              "Región de Los Ríos",
              "Región de Los Lagos",
              "Región de Aysén",
              "Región de Magallanes"
            ]
          },
          "city": {
            "type": "string",
            "description": "City or town where artisan is based",
            "minLength": 1
          },
          "craft_type": {
            "type": "string",
            "description": "Type of artisanal craft",
            "minLength": 1
          },
          "materials_used": {
            "type": "string",
            "description": "Materials and resources used in the craft",
            "minLength": 1
          },
          "cultural_background": {
            "type": "string",
            "description": "Cultural heritage and traditional knowledge",
            "minLength": 1
          },
          "years_of_experience": {
            "type": "integer",
            "description": "Years of experience in the craft",
            "minimum": 0
          },
          "contact_info": {
            "type": "string",
            "description": "Contact information (email)",
            "format": "email"
          }
        }
      }
    }
  }
}
